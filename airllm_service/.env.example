# Ollivo AirLLM Service Configuration
# Copy this file to .env and customize as needed.

# --- Service Host & Networking ---
AIRLLM_HOST=127.0.0.1
AIRLLM_PORT=8765
# Optional secret bearer token for secured internal communication
# AIRLLM_API_KEY=your-secure-internal-token-here

# --- Model Selection & Permissions ---
# Default Hugging Face repository ID or local safetensors directory path
AIRLLM_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# Hugging Face Access Token (required for gated Meta Llama weights)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of approved model IDs
AIRLLM_APPROVED_MODELS=meta-llama/Meta-Llama-3-8B-Instruct,meta-llama/Meta-Llama-3-70B-Instruct,meta-llama/Llama-3.2-3B-Instruct,meta-llama/Llama-3.2-1B-Instruct,Qwen/Qwen2.5-Coder-7B-Instruct,Qwen/Qwen2.5-Coder-32B-Instruct,Qwen/Qwen2.5-72B-Instruct,deepseek-ai/DeepSeek-R1-Distill-Qwen-8B,deepseek-ai/DeepSeek-R1-Distill-Llama-70B,mistralai/Mistral-7B-Instruct-v0.3,hf-internal-testing/tiny-random-LlamaForCausalLM

# --- Hardware & Compression ---
# Device: 'auto' (detects Metal/MPS on Apple Silicon, CUDA on Linux, or CPU), 'cuda:0', 'mps', 'cpu'
AIRLLM_DEVICE=auto

# Block-wise weight compression: '4bit', '8bit', or 'none' (4bit gives ~3x faster inference)
AIRLLM_COMPRESSION=4bit

# Context window & generation limits
AIRLLM_MAX_SEQ_LEN=2048
AIRLLM_MAX_NEW_TOKENS=512

# Layer-by-layer latency profiling
AIRLLM_PROFILING=false

# --- Storage & Shard Cache ---
# Persistent model cache directory
# AIRLLM_CACHE_DIR=/Users/username/.cache/ollivo/airllm/hub

# Directory where layer-split weights are written
# AIRLLM_SHARDS_DIR=/Users/username/.cache/ollivo/airllm/shards

# Minimum free disk space in GB required before starting downloads/sharding
AIRLLM_MIN_FREE_DISK_GB=10.0

# --- Concurrency & Timeouts ---
AIRLLM_MAX_QUEUE_DEPTH=16
AIRLLM_TIMEOUT=180
AIRLLM_WARMUP=false
AIRLLM_MOCK_MODE=false
AIRLLM_LOG_LEVEL=INFO
